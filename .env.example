# .env 로 복사해서 사용한다. .env는 커밋하지 않는다.

# ── 로컬 개발용 (Docker 없이, 직접 설치한 MySQL) ──
# DB_PASSWORD는 IntelliJ 실행 설정의 DB_PASSWORD와 같은 값으로 맞춘다. DB_ROOT_PASSWORD는 로컬에서는 쓰지 않는다.
DB_ROOT_PASSWORD=changeme
DB_NAME=growit
DB_USER=growit
DB_PASSWORD=changeme
DB_PORT=3306

# ── 서버 배포용 (AWS EC2, docker-compose.yml) ──
# DB_ROOT_PASSWORD, DB_NAME, DB_USER, DB_PASSWORD는 위 이름을 그대로 쓰되 서버에서는 로컬과 다른 값을 쓴다.
# DOMAIN: nginx 인증서 경로와 서버 블록에 쓰는 도메인
DOMAIN=grow-it.duckdns.org
SPRING_PROFILES_ACTIVE=prod
APP_CORS_ALLOWED_ORIGINS=https://grow-it.duckdns.org
# JWT_SECRET: JWT 서명용 비밀 키. 32바이트 이상의 임의 문자열이어야 하며, 짧으면 서버가 시작되지 않는다.
# 11/3에 AWS SSM Parameter Store로 옮기기 전까지만 서버 .env에 두는 임시 예외다. 진짜 값은 절대 커밋하지 않는다.
# 서버에서는 `openssl rand -hex 32` 로 만든 값을 쓴다. 로컬 개발은 IntelliJ 실행 설정의 JWT_SECRET을 쓴다.
JWT_SECRET=changeme
JWT_EXPIRATION_DAYS=7
# BCrypt 해시 비용(cost). 높일수록 느려지지만 더 안전하다. 기본값은 10이고, 서버 성능을 보고 조정한다.
# 이 값을 올리면 그다음 로그인부터 기존 사용자의 해시도 새 비용으로 자동으로 다시 저장된다.
PASSWORD_BCRYPT_COST=10
# SWAGGER_ENABLED: Swagger UI(/swagger-ui/index.html)와 API 문서를 켤지 여부.
# 로컬 개발은 true로 쓴다. 서버는 기본 false이고, API를 시험해야 할 때만 잠깐 true로 바꾼다.
SWAGGER_ENABLED=false

# ── AI 호출 설정 (AI_API_KEY는 비밀 값이라 .env에 넣지 않는다. 로컬은 IntelliJ 실행 설정, 서버는 SSM Parameter Store) ──
# AI_API_KEY, AI_MODEL이 비어 있으면 AI 기능은 꺼진 상태로 서버가 정상 시작한다. 실제 값은 여기 적지 않는다.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_CONCURRENCY=2
# 아래 두 한도는 여러 명이 같이 쓰는 공용 키를 보호하기 위한 임시값이다. 낮게 시작하고,
# 공용 키의 실제 한도를 확인한 뒤(과금 계획, rate limit 등) 조정한다.
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
# 한 사용자가 하루에 기록 정리(ANALYSIS)를 몇 번까지 받을 수 있는지. 전체 한도(AI_GLOBAL_DAILY_LIMIT)에는 포함된다.
AI_ANALYSIS_USER_DAILY_LIMIT=30
# 한 사용자가 하루에 AI 회고의 다음 행동을 몇 번까지 더 작게 바꿀 수 있는지(COMPARE+COACH 한도와 별개).
# 전체 한도(AI_GLOBAL_DAILY_LIMIT)에는 포함된다.
AI_SIMPLIFY_USER_DAILY_LIMIT=5
# 한 사용자가 하루에 이 주의 한 줄(WEEKLY)·지표 해석(METRICS)을 합쳐 몇 번까지 받을 수 있는지
# (COMPARE+COACH 한도와 별개). 전체 한도(AI_GLOBAL_DAILY_LIMIT)에는 포함된다.
AI_VIEW_USER_DAILY_LIMIT=20

# 주간 자동 회고(그 주에 처음 접속할 때 서버가 조건에 맞으면 1번만 만드는 COACH)의 사용자별 하루 한도
# (COMPARE+COACH 한도와 별개). 전체 한도(AI_GLOBAL_DAILY_LIMIT)에는 포함된다.
AI_AUTO_USER_DAILY_LIMIT=1
