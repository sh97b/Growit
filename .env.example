# .env 로 복사해서 사용한다. .env는 커밋하지 않는다.

# ── 로컬 개발용 (Docker 없이, 직접 설치한 MySQL) ──
# DB_PASSWORD는 IntelliJ 실행 설정의 DB_PASSWORD와 같은 값으로 맞춘다. DB_ROOT_PASSWORD는 로컬에서는 쓰지 않는다.
DB_ROOT_PASSWORD=changeme
DB_NAME=growit
DB_USER=growit
DB_PASSWORD=changeme
DB_PORT=3306

# ── 서버 배포용 (AWS EC2, docker-compose.yml) ──
# DB_ROOT_PASSWORD, DB_NAME, DB_USER, DB_PASSWORD는 위 이름을 그대로 쓰되 서버에서는 로컬과 다른 값을 쓴다.
# DOMAIN: nginx 인증서 경로와 서버 블록에 쓰는 도메인
DOMAIN=grow-it.duckdns.org
SPRING_PROFILES_ACTIVE=prod
APP_CORS_ALLOWED_ORIGINS=https://grow-it.duckdns.org
# JWT_SECRET: JWT 서명용 비밀 키. 32바이트 이상의 임의 문자열이어야 하며, 짧으면 서버가 시작되지 않는다.
# 11/3에 AWS SSM Parameter Store로 옮기기 전까지만 서버 .env에 두는 임시 예외다. 진짜 값은 절대 커밋하지 않는다.
# 서버에서는 `openssl rand -hex 32` 로 만든 값을 쓴다. 로컬 개발은 IntelliJ 실행 설정의 JWT_SECRET을 쓴다.
JWT_SECRET=changeme
JWT_EXPIRATION_DAYS=7
